# Public Firebase Client SDK (Web app credentials for Firebase project: bio-cart)
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_WEB_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="bio-cart.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="bio-cart"
VITE_FIREBASE_STORAGE_BUCKET="bio-cart.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_WEB_APP_ID"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="(default)"

# Official Active Payment Gateway: Cashfree Payments
# Private server secrets managed via Google Cloud Secret Manager:
# CASHFREE_APP_ID
# CASHFREE_SECRET_KEY
# CASHFREE_ENVIRONMENT="PRODUCTION" (or "SANDBOX")

# Official Active Delivery Partner: EKART by Flipkart
# Private server secrets managed via Google Cloud Secret Manager:
# EKART_CLIENT_ID
# EKART_CLIENT_SECRET
# EKART_ENVIRONMENT="PRODUCTION"
