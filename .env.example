# BioCart Public Client Configuration Template
# COPY THIS FILE TO .env OR .env.local AND FILL IN PROJECT VALUES.
# NEVER COMMIT REAL API KEYS, TOKENS OR SECRETS TO GIT.

# Public Firebase Client SDK (Web app credentials for Firebase project: bio-cart)
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_WEB_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="bio-cart.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="bio-cart"
VITE_FIREBASE_STORAGE_BUCKET="bio-cart.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_WEB_APP_ID"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="(default)"

# Public Razorpay Key ID (Client-side checkout only - NEVER put Key Secret here)
VITE_RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID"

# Private Logistics API Credentials (DELHIVERY / EKART)
# NOTE: Private carrier tokens are securely stored in Firestore under /settings/logistics_api
# (gated strictly to admin users) or managed via Cloud Functions secrets.
# DO NOT put private carrier tokens into frontend environment variables.
