rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // 1. Global Safety Net (Default Deny All)
    // ==========================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ==========================================
    // Primitive Global Security Helpers
    // ==========================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    // Phone OTP accounts prove phone ownership by completing Firebase's SMS
    // challenge; Firebase places the verified phone on the signed ID token.
    function isVerifiedAccount() {
      return isSignedIn() && (isEmailVerified() || request.auth.token.get('phone_number', null) != null);
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Vendor doc id == the vendor's own Firebase Auth uid, or vendor doc has ownerUid == uid
    function isVendorOwner(vendorId) {
      return isSignedIn() && isEmailVerified() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'vendor' &&
        exists(/databases/$(database)/documents/vendors/$(vendorId)) &&
        (
          request.auth.uid == vendorId ||
          (
            'ownerUid' in get(/databases/$(database)/documents/vendors/$(vendorId)).data &&
            get(/databases/$(database)/documents/vendors/$(vendorId)).data.ownerUid == request.auth.uid
          )
        ) &&
        get(/databases/$(database)/documents/vendors/$(vendorId)).data.status in ['active', 'approved'];
    }

    // FIXED: this previously returned `true` unconditionally for everyone
    // ("Temporarily bypassed for local admin access without login"), which
    // meant every isAdmin()-gated collection in this whole file was wide
    // open to any caller, signed in or not. Real check restored below.
    function isAdmin() {
      return isSignedIn() && isEmailVerified() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin'];
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // ==========================================
    // Standalone Validation Blueprints
    // ==========================================
    function isValidUser(data) {
      return data.uid is string &&
             data.email is string &&
             data.name is string &&
             data.role in ['customer', 'guest', 'admin', 'super_admin', 'vendor'] &&
             data.status in ['active', 'suspended'];
    }

    function isValidProduct(data) {
      return data.name is string &&
             data.name.size() <= 200 &&
             data.category is string &&
             data.price is number &&
             data.mrp is number &&
             data.sku is string &&
             data.stockStatus in ['In Stock', 'Low Stock', 'Out of Stock'] &&
             data.inStock is bool;
    }

    function isValidOrder(data) {
      return data.userId is string &&
             data.orderNumber is string &&
             data.paymentMethod in ['cod', 'razorpay', 'stripe', 'card'] &&
             data.paymentStatus in ['pending', 'completed', 'failed', 'refunded'] &&
             data.subtotal is number &&
             data.totalAmount is number;
    }

    function isValidCart(data) {
      return data.userId is string && data.items is list;
    }

    function isValidWishlist(data) {
      return data.userId is string && data.productIds is list;
    }

    function isValidAddress(data) {
      return data.userId is string &&
             data.addressType in ['shipping', 'billing'] &&
             data.name is string &&
             data.street is string &&
             data.city is string &&
             data.state is string &&
             data.postalCode is string &&
             data.phone is string;
    }

    function isValidReview(data) {
      return data.productId is string &&
             data.userId is string &&
             data.rating is number &&
             data.comment is string &&
             data.isApproved is bool;
    }

    function isValidBlog(data) {
      return data.title is string && data.slug is string && data.content is string;
    }

    function isValidCoupon(data) {
      return data.code is string &&
             data.discountType in ['percentage', 'fixed'] &&
             data.discountValue is number &&
             data.usageLimit is number &&
             data.usedCount is number;
    }

    // ==========================================
    // Collection Path Mapping Blocks
    // ==========================================

    // 1. Users Profile Collection
    match /users/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && isOwner(userId) && isValidUser(incoming()) &&
                    incoming().role in ['customer', 'guest'];
      allow update: if isSignedIn() && isOwner(userId) && isValidUser(incoming()) &&
                    ((incoming().role == existing().role && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'phoneNumber', 'location', 'photoURL', 'lastLoginAt', 'updatedAt', 'customerId'])) || isAdmin());
      allow delete: if isAdmin();
    }

    // 2. Products Catalog
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin() || (isVendorOwner(incoming().vendorId) && (!('vendorId' in existing()) || existing().vendorId == incoming().vendorId));
    }

    // 3. Product Categories
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Stock Inventory Levels
    match /inventory/{inventoryId} {
      allow read: if true;
      allow write: if isAdmin() || (isVendorOwner(incoming().vendorId) && (!('vendorId' in existing()) || existing().vendorId == incoming().vendorId));
    }

    // 5. Product Variations
    match /product_variants/{variantId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 6. Purchase Orders
    match /orders/{orderId} {
      allow get: if isSignedIn() && (isOwner(existing().userId) || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      // Orders are calculated and written by createOrder with the Admin SDK.
      allow create: if false;
      allow update: if isVerifiedAccount() && (
        isAdmin() ||
        (isOwner(existing().userId) &&
         incoming().diff(existing()).affectedKeys().hasOnly(['status', 'orderStatus', 'notes', 'cancellationReason', 'updatedAt']) &&
         existing().status in ['placed', 'processing']) // Terminal state locking
      );
      allow delete: if isAdmin();

      // 6b. Per-vendor order slices. A vendor can only ever read their own
      // slice and only ever touch shipment status/tracking on it — never
      // the items, amounts, or commission. Everything else is admin-only
      // (written by the createOrder Cloud Function via the Admin SDK,
      // which bypasses these rules entirely).
      match /vendor_orders/{vendorId} {
        allow read: if isAdmin() || isVendorOwner(vendorId);
        allow update: if isAdmin() || (
          isVendorOwner(vendorId) &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'orderStatus', 'status', 'shipmentStatus', 'trackingNumber', 
            'carrier', 'rejectionReason', 'cancellationReason', 'notes', 'updatedAt'
          ])
        );
        allow write: if isAdmin();
      }
    }

    // 7. Order Line Items
    match /order_items/{itemId} {
      allow read: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
      // Order line items are created by the trusted createOrder function.
      allow write: if false;
    }

    // 8. Customer Shopping Carts
    match /shopping_carts/{cartId} {
      allow read: if isSignedIn() && (isOwner(cartId) || isAdmin());
      allow write: if isVerifiedAccount() && isOwner(cartId) && isValidCart(incoming());
    }

    // 9. Customer Wishlists
    match /wishlists/{wishlistId} {
      allow read: if isSignedIn() && (isOwner(wishlistId) || isAdmin());
      allow write: if isVerifiedAccount() && isOwner(wishlistId) && isValidWishlist(incoming());
    }

    // 10. Saved Addresses
    match /addresses/{addressId} {
      allow read: if isSignedIn() && (isOwner(resource.data.userId) || isAdmin());
      allow create: if isVerifiedAccount() && isOwner(incoming().userId) && isValidAddress(incoming());
      allow update: if isVerifiedAccount() && isOwner(existing().userId) && isValidAddress(incoming());
      allow delete: if isSignedIn() && (isOwner(existing().userId) || isAdmin());
    }

    // 11. Product Reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isVerifiedAccount() && isOwner(incoming().userId) && isValidReview(incoming()) && incoming().isApproved == false;
      allow update, delete: if isAdmin();
    }

    // 12. Corporate Blog Posts
    match /blogs/{blogId} {
      allow read: if true;
      allow write: if isAdmin() && isValidBlog(incoming());
    }

    // 13. Promo Billboard Banners
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 14. Promotional Discount Coupons
    match /coupons/{couponId} {
      // Signed-in users, customers checking out, vendors, and admins can read coupons
      allow read: if isSignedIn();

      // Admins have full create, update, delete permissions
      allow create: if isAdmin() || (
        isVendorOwner(incoming().creatorVendorId) &&
        incoming().creatorRole == 'vendor' &&
        incoming().creatorVendorId is string &&
        incoming().usedCount == 0 &&
        isValidCoupon(incoming())
      );

      allow update: if isAdmin() || (
        isVendorOwner(existing().creatorVendorId) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'discountValue', 'minOrderAmount', 'maxDiscountAmount',
          'startDate', 'endDate', 'usageLimit', 'description', 'applicableProductIds',
          'applicableCategories', 'updatedAt'
        ]) &&
        incoming().creatorVendorId == existing().creatorVendorId &&
        incoming().creatorRole == existing().creatorRole &&
        isValidCoupon(incoming())
      );

      allow delete: if isAdmin() || isVendorOwner(existing().creatorVendorId);
    }

    // 15. Merchant Dealer Applications
    match /dealer_applications/{appId} {
      allow get: if isSignedIn() && (isOwner(resource.data.userId) || isAdmin());
      allow create: if isVerifiedAccount() && isOwner(incoming().userId);
      allow update, delete, list: if isAdmin();
    }

    // 16. Merchant Distributor Applications
    match /distributor_applications/{appId} {
      allow get: if isSignedIn() && (isOwner(resource.data.userId) || isAdmin());
      allow create: if isVerifiedAccount() && isOwner(incoming().userId);
      allow update, delete, list: if isAdmin();
    }

    // 17. User Alerts & Notifications
    match /notifications/{notifId} {
      allow read: if isSignedIn() && (isOwner(resource.data.userId) || isAdmin());
      allow write: if isAdmin();
    }

    // 18. Global Settings Configuration
    match /settings/shipping {
      allow read, write: if isAdmin();
    }

    match /settings/logistics_api {
      allow read, write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 19. Homepage Layout Contents
    match /homepage_contents/{sectionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 19b. CMS Pages
    match /pages/{pageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 19c. Frequently Asked Questions (CMS)
    match /faqs/{faqId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 19d. Customer Testimonials (CMS)
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 19e. Product Promotions (CMS & Storefront)
    match /product_promotions/{promoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 19f. Promotional Ribbons (CMS & Storefront)
    match /promotion_ribbons/{ribbonId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 20. Customer Support Contact Messages
    match /contact_messages/{msgId} {
      allow create: if true; // Public contact form
      allow read, update, delete: if isAdmin();
    }

    // 21. System Counters (Customer ID Generation & Global Sequences)
    match /counters/{counterId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // 21b. Platform Usage Analytics Logs
    match /analytics/{logId} {
      allow create: if true; // Public analytics collector
      allow read, update, delete: if isAdmin();
    }

    // 22. Marketplace Vendors
    // Vendor doc id == the vendor owner's Firebase Auth uid or mapped ownerUid (see
    // isVendorOwner above). Vendors are onboarded via the
    // createVendorAccount Cloud Function (Admin SDK, bypasses rules) —
    // clients never create a vendor doc directly.
    match /vendors/{vendorId} {
      allow read: if isAdmin() || isVendorOwner(vendorId);
      allow list: if isAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'vendor');
      allow create: if isAdmin();
      allow update: if isAdmin() ||
        (isVendorOwner(vendorId) &&
         incoming().diff(existing()).affectedKeys().hasOnly([
           'storeName', 'businessName', 'ownerName', 'phone', 'description', 
           'website', 'addresses', 'legal', 'notificationPreferences', 
           'shippingPreferences', 'orderThresholds', 'logo', 'updatedAt'
         ]));
      allow delete: if isAdmin();
    }

    // 22b. Vendor Wallets — never client-writable. Only the createOrder /
    // settlement Cloud Functions touch this, via the Admin SDK.
    match /vendor_wallets/{vendorId} {
      allow read: if isAdmin() || isVendorOwner(vendorId);
      allow list: if isAdmin() || (isSignedIn() && resource.data.vendorId == request.auth.uid);
      allow write: if isAdmin();
    }

    // 23. Audit Logs
    match /audit_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // 24. Shipments (Delhivery Logistics & Multi-Vendor Tracking)
    match /shipments/{shipmentId} {
      // Signed-in users can read shipments (or vendors can read where vendorId == request.auth.uid, admin can read all)
      allow read: if isSignedIn();
      // Client writes are restricted to authorized admins (automated updates occur via Cloud Functions / Admin SDK)
      allow write: if isAdmin();
    }

    // 25. Field Operations Agents
    match /agents/{agentId} {
      // Admins and agents can read agent profiles
      allow read: if isSignedIn();
      // Only admins can create, modify permissions, or delete agents
      allow write: if isAdmin();
    }

    // 26. Vendor Product Catalog Assignments
    match /vendor_product_assignments/{assignmentId} {
      // Public and customer queries can view catalog assignments
      allow read: if true;
      // Only admins can link/unlink catalogue products
      allow write: if isAdmin();
    }

    // 27. Marketplace Financial Double-Entry Ledger (Zero-Trust)
    match /financial_ledger/{entryId} {
      // Only administrators can read the global ledger (or vendors can query where vendorId == request.auth.uid)
      allow read: if isAdmin() || (isSignedIn() && resource.data.vendorId == request.auth.uid);
      // Ledger writes are strictly Admin SDK / Cloud Functions only
      allow write: if false;
    }

    // 28. Vendor Payouts & Settlement Batches
    match /vendor_settlements/{settlementId} {
      // Admins can read all settlement batches; vendors can read only their own settlement records
      allow read: if isAdmin() || (isSignedIn() && resource.data.vendorId == request.auth.uid);
      // Writes are restricted strictly to authorized admins or Cloud Functions / Admin SDK
      allow write: if isAdmin();
    }
  }
}

