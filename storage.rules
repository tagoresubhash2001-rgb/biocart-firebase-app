rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && request.auth.token.email_verified == true &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.status == 'active' &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin'];
    }
    
    function isVendorOwner(vendorId) {
      return isSignedIn() && request.auth.token.email_verified == true && request.auth.uid == vendorId &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'vendor' &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.status == 'active' &&
        firestore.get(/databases/(default)/documents/vendors/$(vendorId)).data.status in ['active', 'approved'];
    }

    function isValidImage() {
      return request.resource.contentType.matches('image/.*') &&
             request.resource.size <= 10 * 1024 * 1024; // 10MB limit
    }

    match /{allPaths=**} {
      allow read: if true;
    }

    match /products/{allPaths=**} {
      allow write: if isAdmin() && isValidImage();
    }
    match /vendor_products/{vendorId}/{allPaths=**} {
      allow write: if (isAdmin() || isVendorOwner(vendorId)) && isValidImage();
    }
    match /cms/{allPaths=**} {
      allow write: if isAdmin() && isValidImage();
    }
    match /media/{allPaths=**} {
      allow write: if isAdmin() && isValidImage();
    }
    match /categories/{allPaths=**} {
      allow write: if isAdmin() && isValidImage();
    }
    match /banners/{allPaths=**} {
      allow write: if isAdmin() && isValidImage();
    }
    match /vendors/{vendorId}/{allPaths=**} {
      allow write: if (isAdmin() || isVendorOwner(vendorId)) && isValidImage();
    }
    
    match /{allPaths=**} {
      allow write: if false; // Deny all other writes
    }
  }
}
