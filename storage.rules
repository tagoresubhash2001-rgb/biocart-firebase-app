rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      // NOTE: Storage doesn't have direct access to Firestore in standard rules easily without firestore get().
      // In newer rules we can use firestore.get.
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      let role = getUserData().role;
      return isSignedIn() && (role == 'admin' || role == 'super_admin');
    }
    
    function isVendor() {
      return isSignedIn() && getUserData().role == 'vendor';
    }

    function isValidImage() {
      return request.resource.contentType.matches('image/.*') &&
             request.resource.size <= 10 * 1024 * 1024; // 10MB limit
    }

    match /{allPaths=**} {
      allow read: if true;
    }

    match /products/{imageId} {
      allow write: if (isAdmin() || isVendor()) && isValidImage();
    }
    match /vendor_products/{imageId} {
      allow write: if (isAdmin() || isVendor()) && isValidImage();
    }
    match /media/{imageId} {
      allow write: if isAdmin() && isValidImage();
    }
    match /categories/{imageId} {
      allow write: if isAdmin() && isValidImage();
    }
    match /banners/{imageId} {
      allow write: if isAdmin() && isValidImage();
    }
    match /vendors/{vendorId}/{imageId} {
      allow write: if (isAdmin() || (isVendor() && firestore.get(/databases/(default)/documents/vendors/$(vendorId)).data.ownerUid == request.auth.uid)) && isValidImage();
    }
    
    match /{allPaths=**} {
      allow write: if false; // Deny all other writes
    }
  }
}
