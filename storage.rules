rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && request.auth.token.email_verified == true &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.status == 'active' &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin'];
    }
    
    function isVendorOwner(vendorId) {
      return isSignedIn() && request.auth.token.email_verified == true &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'vendor' &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.status == 'active' &&
        firestore.get(/databases/(default)/documents/vendors/$(vendorId)).data.status in ['active', 'approved'] &&
        (
          request.auth.uid == vendorId ||
          firestore.get(/databases/(default)/documents/vendors/$(vendorId)).data.ownerUid == request.auth.uid
        );
    }

    function isValidImage() {
      return request.resource.contentType.matches('image/.*') &&
             request.resource.size <= 10 * 1024 * 1024; // 10MB limit
    }

    // Public Storefront Assets
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
    }
    match /vendor_products/{vendorId}/{allPaths=**} {
      allow read: if true;
      allow write: if (isAdmin() || isVendorOwner(vendorId)) && isValidImage();
    }
    match /cms/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
    }
    match /media/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
    }
    match /categories/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
    }
    match /banners/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
    }
    match /vendors/{vendorId}/{allPaths=**} {
      allow read: if true;
      allow write: if (isAdmin() || isVendorOwner(vendorId)) && isValidImage();
    }
    match /avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == userId && isValidImage();
    }

    // Confidential KYC Documents - only vendor owner and admin
    match /kyc/{vendorId}/{allPaths=**} {
      allow read, write: if (isAdmin() || isVendorOwner(vendorId));
    }

    // Invoices - only the specific customer and admin
    match /invoices/{userId}/{allPaths=**} {
      allow read: if (isAdmin() || (isSignedIn() && request.auth.uid == userId));
      allow write: if false; // Generated via Cloud Functions (Admin SDK)
    }

    // Global Deny for all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
